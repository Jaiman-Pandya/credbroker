# Copy to .env for local development. Never commit a real .env.

CREDBROKER_DATABASE_URL=postgresql+asyncpg://credbroker:credbroker@localhost:5432/credbroker
CREDBROKER_REDIS_URL=redis://localhost:6379/0

# Google OAuth app (https://console.cloud.google.com/apis/credentials)
CREDBROKER_GOOGLE_CLIENT_ID=
CREDBROKER_GOOGLE_CLIENT_SECRET=
CREDBROKER_PUBLIC_BASE_URL=http://localhost:8000
CREDBROKER_OAUTH_STATE_SECRET=change-me

# Leave CREDBROKER_KMS_KEY_ID empty to use the local dev key manager.
# In AWS, set it to the KMS key ARN and the broker uses real envelope encryption.
CREDBROKER_KMS_KEY_ID=
CREDBROKER_AWS_REGION=us-east-1
# Dev-only master key (base64, 32 bytes): python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
CREDBROKER_LOCAL_MASTER_KEY_B64=

# Grant token signing keypair (PEM). Generate for dev:
#   openssl genpkey -algorithm RSA -out jwt_private.pem
#   openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
CREDBROKER_JWT_PRIVATE_KEY_PEM=
CREDBROKER_JWT_PUBLIC_KEY_PEM=
